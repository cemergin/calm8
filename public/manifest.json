{
  "manifest_version": 3,
  "name": "EventSeek",
  "version": "0.1",
  "description": "Extract event info and save to Google Calendar.",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["tabs", "activeTab"]
}
